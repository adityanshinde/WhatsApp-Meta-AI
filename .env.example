WA_HOST=127.0.0.1
WA_PORT=8000
WA_PROFILE_DIR=wa_profile
# Defaults to ~/Downloads/wa-meta-ai when unset
WA_DOWNLOADS_DIR=downloads
WA_SAVE_MANIFEST=false
WA_DEFAULT_FORMAT=png
WA_COOLDOWN_SEC=2.0
WA_JITTER_SEC=1.5
WA_HEADLESS=false
# Optional: set to require X-API-Key or Bearer token
# WA_META_AI_API_KEY=your-secret-key
# Optional: attach to an existing Chrome launched with --remote-debugging-port=9222
# WA_CDP_URL=http://127.0.0.1:9222
